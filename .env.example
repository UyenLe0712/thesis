# ─────────────────────────────────────────────────────────────────────
#  Khoá riêng của máy này. KHÔNG commit, KHÔNG dán vào ô mã Colab/Kaggle,
#  KHÔNG dán vào chat. .gitignore đã chặn sẵn tệp này.
#
#  Nạp vào shell:   set -a; source .env; set +a
#  Nạp trong Python: os.environ (đã có sau lệnh trên), hoặc python-dotenv
# ─────────────────────────────────────────────────────────────────────

# GitHub — token cá nhân để push. Tạo ở:
#   github.com → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → chọn đúng repo này, quyền Contents: Read and write
GITHUB_TOKEN=
GITHUB_USER=

# OpenAI / VLM — harness/_apikey.py đọc theo thứ tự VLM_API_KEY → OPENAI_API_KEY
# → harness/.openai_key. Đặt ở đây thì khỏi cần tệp .openai_key nữa.
OPENAI_API_KEY=
VLM_API_KEY=

# HuggingFace — cần khi tải Qwen2.5-VL / UGround / UI-Venus
# (trên Colab lấy từ Secrets, trên Kaggle lấy từ Add-ons → Secrets, đừng dán vào ô mã)
HF_TOKEN=

# Kaggle — tải về từ kaggle.com → Settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
