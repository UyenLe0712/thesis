\title{Descriptor-First Supervision for GUI Instruction\\
Generation: A Pre-Registered Ablation and the\\
Condition Under Which It Pays}

\author{\IEEEauthorblockN{Lê Đoàn Phương Uyên}
\IEEEauthorblockA{\textit{Faculty of Information Technology} \\
