!harness/dg1_cache/train_ac/pata/
harness/dg1_cache/train_ac/pata/*
!harness/dg1_cache/train_ac/pata/split_hash.json
!harness/dg1_cache/train_ac/pata/probe40.jsonl
!harness/dg1_cache/train_ac/pata/val600_swap.jsonl
!harness/dg1_cache/train_ac/pata/swap_hash.json
!harness/dg1_cache/train_ac/pata/audit/
harness/dg1_cache/train_ac/pata/audit/*
!harness/dg1_cache/train_ac/pata/audit/manifest.json
!harness/dg1_cache/train_ac/pata/audit/audit.html
!harness/dg1_cache/train_ac/pata/audit/audit_*.json

